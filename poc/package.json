{
  "name": "workboard-poc",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Shellside PoC: wterm terminal + AI-built tool board + agent bridge (MCP / wb CLI)",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "wb": "./bin/wb.mjs"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "dev:server:watch": "tsx watch --clear-screen=false server/index.ts",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');const d=p.join('node_modules','node-pty','prebuilds');if(fs.existsSync(d))for(const x of fs.readdirSync(d)){const f=p.join(d,x,'spawn-helper');if(fs.existsSync(f))fs.chmodSync(f,0o755)}\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@wterm/core": "^0.5.6",
    "@wterm/dom": "^0.5.6",
    "@wterm/react": "^0.5.6",
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.28.2",
    "fast-json-patch": "^3.1.1",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sucrase": "^3.35.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
