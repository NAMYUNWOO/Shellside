<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the Windows installer, built from the signed app and uploaded as a
     zip by CI. CI passes the app's version (desktop/package.json) as the "version" parameter. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Shellside-Setup-${version}-x64.exe" product-name="Shellside" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
