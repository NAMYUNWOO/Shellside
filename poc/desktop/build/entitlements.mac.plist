<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime exceptions for the signed app (electron-builder.config.cjs). -->
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript at run time (Electron's own requirement for notarized apps). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Native Node modules (node-pty) load into the app's processes. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Programs in a board terminal (osascript, say) may script other apps; macOS asks the person first. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
